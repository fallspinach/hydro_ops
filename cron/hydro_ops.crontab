# Hydro Ops recurring jobs
#
# Keep this file as the version-controlled source of truth for project schedules.
# Copy individual entries into `crontab -e` after reviewing paths for the target host.

# Refresh and report forcing coverage every six hours (local cron time).
0 */6 * * * cd /cw3e/mead/projects/cwp206/agentization/hydro_ops && /home/mpan/local/miniforge3/bin/conda run --no-capture-output --name hydro-ops python bin/update_forcing.py >> logs/update-forcing.log 2>&1

# Revisit the latest 72 forcing hours after download submissions have had time to start.
# Resumability skips already complete hours; the SLURM array is capped at four concurrent tasks.
15 1,7,13,19 * * * cd /cw3e/mead/projects/cwp206/agentization/hydro_ops && /home/mpan/local/miniforge3/bin/conda run --no-capture-output --name hydro-ops python bin/submit_forcing_production.py >> logs/submit-forcing-production.log 2>&1

# Fast NRT pass: Stage-IV's 1/3/5/7-day revisions and delayed NLDAS-2 fit in 10 days.
45 2,8,14,20 * * * cd /cw3e/mead/projects/cwp206/agentization/hydro_ops && /home/mpan/local/miniforge3/bin/conda run --no-capture-output --name hydro-ops python bin/submit_prism_forcing_updates.py --stream nrt --lookback-days 10 --complete-root outputs/forcing/nwm --output-root outputs/forcing/nwm_prism/nrt >> logs/submit-prism-nrt.log 2>&1

# Daily NRT reconciliation: cover PRISM's complete mutable six-month revision period.
30 4 * * * cd /cw3e/mead/projects/cwp206/agentization/hydro_ops && /home/mpan/local/miniforge3/bin/conda run --no-capture-output --name hydro-ops python bin/submit_prism_forcing_updates.py --stream nrt --lookback-days 200 --complete-root outputs/forcing/nwm --output-root outputs/forcing/nwm_prism/nrt >> logs/submit-prism-nrt-daily.log 2>&1

# Monthly retrospective pass after PRISM's normal mid-month update. For retro, the scheduler's
# window ends at the six-month stability boundary, so 45 days cover newly stable releases/retries.
30 5 18 * * cd /cw3e/mead/projects/cwp206/agentization/hydro_ops && /home/mpan/local/miniforge3/bin/conda run --no-capture-output --name hydro-ops python bin/submit_prism_forcing_updates.py --stream retro --lookback-days 45 --complete-root outputs/forcing/nwm --output-root outputs/forcing/nwm_prism/retro >> logs/submit-prism-retro.log 2>&1

# Hydro Ops recurring jobs
#
# Keep this file as the version-controlled source of truth for project schedules.
# This is the current-site rendering. For relocation render hydro_ops.crontab.in
# using bin/render_crontab.py; rendering never installs or changes a crontab.
# Copy individual entries into `crontab -e` after reviewing paths for the target host.

CRON_TZ=UTC
# Install on ONE login node only. run_cron.sh supplies Python and SLURM explicitly.
# Preflight: env -i PATH=/usr/bin:/bin /usr/bin/bash bin/run_cron.sh --check

# NRT at 2.5 hours after each synoptic boundary. Daily replaces six-hourly at 02:30 UTC.
# All cycles extend latest hours first with required GFS northern fallback.
# Only daily continues into broader source refresh, revisions, and summaries.
30 8,14,20 * * * /usr/bin/bash /cw3e/mead/projects/cwp206/agentization/hydro_ops/bin/run_cron.sh bin/update_nwm_forcing.py --cycle six-hourly >> /cw3e/mead/projects/cwp206/agentization/hydro_ops/forcing/logs/nwm-cycle-six-hourly.log 2>&1
30 2 * * * /usr/bin/bash /cw3e/mead/projects/cwp206/agentization/hydro_ops/bin/run_cron.sh bin/update_nwm_forcing.py --cycle daily >> /cw3e/mead/projects/cwp206/agentization/hydro_ops/forcing/logs/nwm-cycle-daily.log 2>&1

# Stable retrospective promotion after PRISM's normal mid-month revision cycle. Cleanup is a
# dependency-gated final stage and never runs inside parallel PRISM workers.
# Prefer ordinary resources for this non-urgent cycle, not NRTRES.
0 18 18 * * /usr/bin/bash /cw3e/mead/projects/cwp206/agentization/hydro_ops/bin/run_cron.sh bin/update_nwm_forcing.py --cycle monthly-retro >> /cw3e/mead/projects/cwp206/agentization/hydro_ops/forcing/logs/nwm-cycle-retro.log 2>&1

# Read-only dashboard status every two hours (may coincide with cycle submission). The
# writer atomically replaces the canonical JSON document, so web readers never see partial JSON.
30 */2 * * * /usr/bin/bash /cw3e/mead/projects/cwp206/agentization/hydro_ops/bin/run_cron.sh bin/report_forcing_status.py --format json --output forcing/status/forcing-status.json >> /cw3e/mead/projects/cwp206/agentization/hydro_ops/forcing/logs/forcing-status.log 2>&1

# CNRFC catch-up is dependency-chained by the forcing cycles; no separate cron row.
# CDEC FNF observations: daily full-history refresh at 19 UTC (11 PST), ordinary resources.
0 19 * * * /usr/bin/bash /cw3e/mead/projects/cwp206/agentization/hydro_ops/bin/run_cron.sh bin/submit_cdec_fnf.py >> /cw3e/mead/projects/cwp206/agentization/hydro_ops/observations/logs/cdec-fnf-submit.log 2>&1
# SWE: native sensor-3/82 updates; wait for accepted initial backfill; no NRTRES.
15 19 * * * /usr/bin/bash /cw3e/mead/projects/cwp206/agentization/hydro_ops/bin/run_cron.sh bin/submit_cdec_swe.py >> /cw3e/mead/projects/cwp206/agentization/hydro_ops/observations/logs/cdec-swe-submit.log 2>&1
# Temporary Stage-IV revision observations through November 30, 2026; no production writes.
0 18 * * * /usr/bin/bash /cw3e/mead/projects/cwp206/agentization/hydro_ops/bin/run_cron.sh bin/submit_stage4_revision_monitor.py --until 2026-11-30 >> /cw3e/mead/projects/cwp206/agentization/hydro_ops/forcing/logs/stage4-revision-monitor.log 2>&1

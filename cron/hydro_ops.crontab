# Hydro Ops recurring jobs
#
# Keep this file as the version-controlled source of truth for project schedules.
# Copy individual entries into `crontab -e` after reviewing paths for the target host.

CRON_TZ=UTC

# Coordinated NRT cycles. The 08 UTC slot is the deeper daily convergence pass, so the ordinary
# six-hourly entry deliberately omits hour 08.
0 2,14,20 * * * cd /cw3e/mead/projects/cwp206/agentization/hydro_ops && /home/mpan/local/miniforge3/bin/conda run --no-capture-output --name hydro-ops python bin/update_nwm_forcing.py --cycle six-hourly >> logs/nwm-cycle-six-hourly.log 2>&1
0 8 * * * cd /cw3e/mead/projects/cwp206/agentization/hydro_ops && /home/mpan/local/miniforge3/bin/conda run --no-capture-output --name hydro-ops python bin/update_nwm_forcing.py --cycle daily >> logs/nwm-cycle-daily.log 2>&1

# Stable retrospective promotion after PRISM's normal mid-month revision cycle. Cleanup is a
# dependency-gated final stage and never runs inside parallel PRISM workers.
0 10 18 * * cd /cw3e/mead/projects/cwp206/agentization/hydro_ops && /home/mpan/local/miniforge3/bin/conda run --no-capture-output --name hydro-ops python bin/update_nwm_forcing.py --cycle monthly-retro >> logs/nwm-cycle-retro.log 2>&1

# Read-only dashboard status, offset 30 minutes from the even-hour production submissions. The
# writer atomically replaces the canonical JSON document, so web readers never see partial JSON.
30 */2 * * * cd /cw3e/mead/projects/cwp206/agentization/hydro_ops && /home/mpan/local/miniforge3/bin/conda run --no-capture-output --name hydro-ops python bin/report_forcing_status.py --format json --output outputs/status/forcing-status.json >> logs/forcing-status.log 2>&1

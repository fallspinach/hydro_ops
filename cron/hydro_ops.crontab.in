# Hydro Ops schedule template; render with bin/render_crontab.py.
# Install on ONE host only after review. This file is not directly installable.
CRON_TZ=UTC

# NRT at 2.5 hours after each synoptic boundary; daily replaces six-hourly at 02:30 UTC.
30 8,14,20 * * * /usr/bin/bash @WRAPPER@ bin/update_nwm_forcing.py --cycle six-hourly >> @LOG_ROOT@/nwm-cycle-six-hourly.log 2>&1
30 2 * * * /usr/bin/bash @WRAPPER@ bin/update_nwm_forcing.py --cycle daily >> @LOG_ROOT@/nwm-cycle-daily.log 2>&1
# Stable retrospective promotion; prefer ordinary resources, not NRTRES.
0 18 18 * * /usr/bin/bash @WRAPPER@ bin/update_nwm_forcing.py --cycle monthly-retro >> @LOG_ROOT@/nwm-cycle-retro.log 2>&1
# Read-only dashboard status.
30 */2 * * * /usr/bin/bash @WRAPPER@ bin/report_forcing_status.py --format json --output forcing/status/forcing-status.json >> @LOG_ROOT@/forcing-status.log 2>&1
# CNRFC catch-up is dependency-chained by the forcing cycles; no separate cron row.
# CDEC FNF observations: daily full-history refresh at 19 UTC (11 PST), ordinary resources.
0 19 * * * /usr/bin/bash @WRAPPER@ bin/submit_cdec_fnf.py >> @OBS_LOG_ROOT@/cdec-fnf-submit.log 2>&1
# SWE: native sensor-3/82 updates; wait for accepted initial backfill; no NRTRES.
15 19 * * * /usr/bin/bash @WRAPPER@ bin/submit_cdec_swe.py >> @OBS_LOG_ROOT@/cdec-swe-submit.log 2>&1
# Temporary Stage-IV revision observations through November 30, 2026; no production writes.
0 18 * * * /usr/bin/bash @WRAPPER@ bin/submit_stage4_revision_monitor.py --until 2026-11-30 >> @LOG_ROOT@/stage4-revision-monitor.log 2>&1

# Hydro Ops schedule template; render with bin/render_crontab.py.
# Install on ONE host only after review. This file is not directly installable.
CRON_TZ=UTC

# NRT at 2.5 hours after each synoptic boundary; daily replaces six-hourly at 02:30 UTC.
30 8,14,20 * * * /usr/bin/bash @WRAPPER@ bin/update_nwm_forcing.py --cycle six-hourly >> @LOG_ROOT@/nwm-cycle-six-hourly.log 2>&1
30 2 * * * /usr/bin/bash @WRAPPER@ bin/update_nwm_forcing.py --cycle daily >> @LOG_ROOT@/nwm-cycle-daily.log 2>&1
# Stable retrospective promotion.
0 10 18 * * /usr/bin/bash @WRAPPER@ bin/update_nwm_forcing.py --cycle monthly-retro >> @LOG_ROOT@/nwm-cycle-retro.log 2>&1
# Read-only dashboard status.
30 */2 * * * /usr/bin/bash @WRAPPER@ bin/report_forcing_status.py --format json --output forcing/status/forcing-status.json >> @LOG_ROOT@/forcing-status.log 2>&1

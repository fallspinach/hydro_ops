# Trusted shell settings for the AWARE installation. No secrets belong here.
# Environment overrides win; config/site.local.env may override these locally.
: "${HYDRO_OPS_ENV_BIN:=/home/mpan/local/miniforge3/envs/hydro-ops/bin}"
: "${HYDRO_OPS_SLURM_ROOT:=/cm/shared/apps/slurm/current}"
: "${HYDRO_OPS_SLURM_CONF:=/cm/shared/apps/slurm/var/etc/AWARE/slurm.conf}"
: "${HYDRO_OPS_CLUSTER:=AWARE}"

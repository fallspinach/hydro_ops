# Downloaded and generated products
data/**
!data/**/
!data/**/.gitkeep
outputs/**
!outputs/.gitkeep
logs/**
!logs/.gitkeep
work/**
!work/.gitkeep

# Canonical forcing and NWM subprojects (retain directory markers only)
forcing/**

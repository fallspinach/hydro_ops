+  subroutine get_2d_netcdf_record(name, ncid, array, units, idim, jdim, time_index, fatal, ierr)
+    implicit none
+    character(len=*), intent(in) :: name
+    integer, intent(in) :: ncid, idim, jdim, time_index
+    real, dimension(idim,jdim), intent(out) :: array
+    character(len=*), intent(out) :: units
+    logical, intent(in) :: fatal
+    integer, intent(out) :: ierr
+    integer :: varid
+    integer :: att_ierr
+    real :: scale_factor, add_offset
+
+    units = ""
+    ierr = nf90_inq_varid(ncid, trim(name), varid)
+    if (ierr == NF90_NOERR) ierr = nf90_get_att(ncid, varid, "units", units)
+    if (ierr /= NF90_NOERR .and. .not. fatal) then
+       ierr = nf90_inq_varid(ncid, trim(name), varid)
+    endif
+    if (ierr == NF90_NOERR) then
+       ierr = nf90_get_var(ncid, varid, array, start=(/1,1,time_index/), count=(/idim,jdim,1/))
+       if (ierr == NF90_NOERR) then
+          att_ierr = nf90_get_att(ncid, varid, "scale_factor", scale_factor)
+          if (att_ierr == NF90_NOERR) array = array * scale_factor
+          att_ierr = nf90_get_att(ncid, varid, "add_offset", add_offset)
+          if (att_ierr == NF90_NOERR) array = array + add_offset
+       endif
+    endif
+    if (ierr /= NF90_NOERR .and. fatal) then
+       write(*,'("Problem reading daily forcing variable ''", A, "'', record ", I0)') trim(name), time_index
+       call hydro_stop("In get_2d_netcdf_record()")
+    endif
+  end subroutine get_2d_netcdf_record
+



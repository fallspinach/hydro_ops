+   character(len=19) :: currentDate
+   real, allocatable :: flowNow(:), nudgeNow(:), velocityNow(:)
+   real, allocatable :: sfcNow(:), bucketNow(:), btmNow(:)
+
+   hourlyEnabled = nlst(domainId)%CHRTOUT_HOURLY .eq. 1
+   dailyEnabled = nlst(domainId)%CHRTOUT_DAILY .eq. 1
+   if(.not. hourlyEnabled .and. .not. dailyEnabled) return
+
+   dailyReady = .false.
+   call geth_newdate(currentDate,nlst(domainId)%startdate,&
+        nint(nlst(domainId)%out_dt*60*(rt_domain(domainId)%out_counts-1)))
+   if(dailyEnabled .and. rt_domain(1)%out_counts .gt. 1) then
+      if(nint(nlst(domainId)%out_dt) .ne. 60) then
+         call hydro_stop('Native daily CHRTOUT currently requires out_dt=60 minutes')
+      endif
+      if(.not. allocated(chrtDailyFlow)) then
+         allocate(chrtDailyFlow(size(rt_domain(domainId)%QLINK,1)))
+         allocate(chrtDailyNudge(size(rt_domain(domainId)%QLINK,1)))
+         allocate(chrtDailyVelocity(size(rt_domain(domainId)%QLINK,1)))
+         allocate(chrtDailySfcRunoff(size(rt_domain(domainId)%QLINK,1)))
+         allocate(chrtDailyBucket(size(rt_domain(domainId)%QLINK,1)))
+         allocate(chrtDailyBtmRunoff(size(rt_domain(domainId)%QLINK,1)))
+         chrtDailyFlow = 0.0
+         chrtDailyNudge = 0.0
+         chrtDailyVelocity = 0.0
+         chrtDailySfcRunoff = 0.0
+         chrtDailyBucket = 0.0
+         chrtDailyBtmRunoff = 0.0
+      endif
+      chrtDailyCount = chrtDailyCount + 1
+      chrtDailyFlow = chrtDailyFlow + rt_domain(domainId)%QLINK(:,1)
+      chrtDailyVelocity = chrtDailyVelocity + rt_domain(domainId)%velocity
+      chrtDailySfcRunoff = chrtDailySfcRunoff + rt_domain(domainId)%qSfcLatRunoff
+      chrtDailyBucket = chrtDailyBucket + rt_domain(domainId)%qBucket
+      chrtDailyBtmRunoff = chrtDailyBtmRunoff + rt_domain(domainId)%qin_gwsubbas
+#ifdef WRF_HYDRO_NUDGING
+      chrtDailyNudge = chrtDailyNudge + rt_domain(domainId)%nudge
+#endif
+      if(currentDate(12:16) .eq. '00:00') then
+         dailyReady = chrtDailyCount .eq. 24
+      endif
+   endif
+
+   if(hourlyEnabled) call output_chrt_NWM_record(domainId, .false.)
+   if(dailyReady) then
+      allocate(flowNow(size(chrtDailyFlow)), nudgeNow(size(chrtDailyNudge)))
+      allocate(velocityNow(size(chrtDailyVelocity)), sfcNow(size(chrtDailySfcRunoff)))
+      allocate(bucketNow(size(chrtDailyBucket)), btmNow(size(chrtDailyBtmRunoff)))
+      flowNow = rt_domain(domainId)%QLINK(:,1)
+      velocityNow = rt_domain(domainId)%velocity
+      sfcNow = rt_domain(domainId)%qSfcLatRunoff
+      bucketNow = rt_domain(domainId)%qBucket
+      btmNow = rt_domain(domainId)%qin_gwsubbas
+      rt_domain(domainId)%QLINK(:,1) = chrtDailyFlow / real(chrtDailyCount)
+      rt_domain(domainId)%velocity = chrtDailyVelocity / real(chrtDailyCount)
+      rt_domain(domainId)%qSfcLatRunoff = chrtDailySfcRunoff / real(chrtDailyCount)
+      rt_domain(domainId)%qBucket = chrtDailyBucket / real(chrtDailyCount)
+      rt_domain(domainId)%qin_gwsubbas = chrtDailyBtmRunoff
+#ifdef WRF_HYDRO_NUDGING
+      nudgeNow = rt_domain(domainId)%nudge
+      rt_domain(domainId)%nudge = chrtDailyNudge / real(chrtDailyCount)
+#endif
+      call output_chrt_NWM_record(domainId, .true.)
+      rt_domain(domainId)%QLINK(:,1) = flowNow
+      rt_domain(domainId)%velocity = velocityNow
+      rt_domain(domainId)%qSfcLatRunoff = sfcNow
+      rt_domain(domainId)%qBucket = bucketNow
+      rt_domain(domainId)%qin_gwsubbas = btmNow
+#ifdef WRF_HYDRO_NUDGING
+      rt_domain(domainId)%nudge = nudgeNow
+#endif
+      deallocate(flowNow, nudgeNow, velocityNow, sfcNow, bucketNow, btmNow)
+   endif
+   if(dailyEnabled .and. currentDate(12:16) .eq. '00:00') then
+      chrtDailyCount = 0
+      chrtDailyFlow = 0.0
+      chrtDailyNudge = 0.0
+      chrtDailyVelocity = 0.0
+      chrtDailySfcRunoff = 0.0
+      chrtDailyBucket = 0.0
+      chrtDailyBtmRunoff = 0.0
+   endif
+end subroutine output_chrt_NWM
